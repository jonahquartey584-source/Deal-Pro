{
  "name": "whatsapp-personal-bot",
  "private": true,
  "type": "module",
  "description": "Personal WhatsApp assistant that runs on your Mac: auto-replies, AI drafts you approve, and alerts sent to your own chat.",
  "scripts": {
    "start": "node bot.js",
    "start:awake": "caffeinate -i node bot.js",
    "show": "caffeinate -i node bot.js --show",
    "reset": "node scripts/reset.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "github:wwebjs/whatsapp-web.js#38eb45b2759450cc6fccb6a7a3f2cbc3bdb87db2",
    "qrcode": "^1.5.4",
    "openai": "^7.65.0"
  },
  "devDependencies": {
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0"
  }
}
